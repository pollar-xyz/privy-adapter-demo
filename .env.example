# Privy app credentials (from this customer's Privy dashboard)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Bearer token Pollar uses to call this adapter (32+ random bytes; generate once)
# Example: openssl rand -hex 32
POLLAR_API_SECRET=

# Stellar network the adapter will use (must match the value registered in Pollar)
STELLAR_NETWORK=testnet

# Port the adapter listens on (plain HTTP — terminate TLS at the LB / ingress)
ADAPTER_PORT=3001

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
